// This is the OpenDSS Master file to solve the test system time-series power flow using loadshapes.

Clear
New Circuit.240_bus_test_system   ! Initiate a new circuit called '240_bus_test_system' 


! ELEMENTOS DO SISTEMA
!--------------------------------------------------------!
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/Vsource.dss"                               ! Source definition
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/SubTransformer.dss"                        ! Substation transformer definition
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/RegControl.dss"                            ! Tap changer control definition
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/DistriTransformer.dss"                     ! Secondary distribution transformer definition
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/Linecode.dss"                              ! Line configuration
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/Line.dss"                                  ! Line segment definition
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/CircuitBreaker.dss"                        ! Circuit breaker definition
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/Capacitor.dss"                             ! Shunt capacitor bank definition



! ==============================
! LOADSHAPES
! ==============================
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/loadshapes/Loadshapes_FeederA.dss"
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/loadshapes/Loadshapes_FeederB.dss"
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/loadshapes/Loadshapes_FeederC.dss"
Redirect "/home/matheus/Documentos/BtM-PV-estimating/scripts/loadshapes/loadshapes.dss"


! ==============================
! LOADS
! ==============================
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/loads/Loads_FeederA.dss"
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/loads/Loads_FeederB.dss"
Redirect "/home/matheus/Documentos/BtM-PV-estimating/dss/loads/Loads_FeederC.dss"
Redirect "/home/matheus/Documentos/BtM-PV-estimating/scripts/PVSystems_10.dss"



!--------------------------Calculate---------------------!
Set VoltageBases = "69.0, 13.8, 0.208"	! Set base voltage as 69 kV, 13.8 kV, 0.208 kV
CalcVoltageBases			! Estimate the voltage base for each bus
solve					! Solve the circuit
BusCoords       Buscoords.dss




!-------------Show Snapshot Power Flow Result------------!
!Show Voltage LN Nodes
!Show currents
!Show power kva element
!Show convergence
!Show isolated
!Show kvbasemismatch
!Show losses
!Show overloads
!Show topology



!----------------- Plotting -----------------------!

!Set markCapacitors=yes  CapMarkersize=3
!Set markRegulators=yes  RegMarkersize=5
!Interpolate
!Plot Circuit Power Max=500 dots=n labels=n  C1=Blue  1ph=3   ! $00FF0000
!Plot Circuit voltage Max=0 dots=n n  C1=Blue C2=$FF00FF  1ph=3
!plot circuit Losses Max=1 dots=n labels=n subs=y C1=Blue
